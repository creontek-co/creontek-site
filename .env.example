# The contact form delivers through at least one of these channels.
# With neither configured it shows an error and points people to the booking link.

# Email via SMTP. Defaults to Gmail; only SMTP_PASS is required.
# SMTP_PASS is a Google App Password (myaccount.google.com/apppasswords),
# not your normal Gmail password. 2-Step Verification must be on.
SMTP_PASS=
# Optional: the mailbox that signs in and sends (default abrahamosas3@gmail.com).
SMTP_USER=
# Optional: where enquiries are delivered (default abrahamosas3@gmail.com).
CONTACT_TO_EMAIL=
# Optional: only for a non-Gmail mailbox (e.g. a creontek.co address).
SMTP_HOST=
SMTP_PORT=

# CRM: any webhook that accepts a JSON POST
CRM_WEBHOOK_URL=
